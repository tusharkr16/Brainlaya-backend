# Server
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed frontend origins (Vite dev + your prod domain)
CLIENT_ORIGIN=http://localhost:5173,https://app.brainlaya.example.com

# Mongo (Atlas connection string, or mongodb://localhost:27017/brainlaya for a local mongod)
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/brainlaya?retryWrites=true&w=majority

# JWT — generate real random secrets for prod, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
